node_modules/
dist/
*.tsbuildinfo

# per-branch finding ledger, written into a reviewed worktree (SPEC §4.3)
.rev/

# Agent worktrees. Each is a full checkout with its own node_modules — 1.1G here
# during one workflow run — and git worktrees are NOT ignored automatically when
# they live inside the parent repo.
#
# This matters more than it looks: the review loop builds its submission with
# `git add -A && git write-tree`, so an unignored worktree directory would put
# every agent's checkout into the tree hash lore verifies against.
.claude/

.DS_Store
*.log
.env
.env.*

# Staged opencode credentials and deployment secrets. Never committed.
deploy/opencode/
deploy/.env

# Project-local MCP wiring. Points at a private host and is per-machine, so it
# does not belong in a public repository even though the token itself is an env
# reference rather than a literal.
.mcp.json
